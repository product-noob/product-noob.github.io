---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  buildCompactPrompt,
  buildFullPrompt,
  screenTypes,
  stackOptions,
  vibes,
} from '../data/vibes';
import type { VibeCategory } from '../types';

const categories: Array<'All' | VibeCategory> = [
  'All',
  'Content',
  'Internal tools',
  'Consumer',
  'B2B',
  'Experimental',
];

const defaultVibe = vibes[0];
const defaultScreen = screenTypes[0];
const defaultPrompt = buildCompactPrompt(defaultVibe, {
  screenTypeId: defaultScreen.id,
  stackId: stackOptions[0].id,
});
---

<BaseLayout
  title="UI Vibes — Build a Better UI Prompt | Prince Jain"
  description="Choose a visual direction and screen type, then generate a copy-ready UI prompt for Claude, Cursor, v0, Lovable, or any coding LLM."
  breadcrumbs={[
    { name: 'Home', url: 'https://princejain.me' },
    { name: 'UI Vibes' },
  ]}
>
  <main class="vibes-page">
    <section class="vibes-hero">
      <div class="container">
        <p class="vibes-hero__eyebrow">UI PROMPT BUILDER</p>
        <h1 class="vibes-hero__title">Pick the UI before you start prompting.</h1>
        <p class="vibes-hero__subtitle">
          Choose how the product should feel and what kind of screen you are building.
          Get a copy-ready prompt that saves iterations, context, and tokens.
        </p>
        <div class="vibes-hero__meta">
          <a href="/blogs/picking-the-right-ui-for-vibe-coding/">Read how I use this framework</a>
          <span aria-hidden="true">·</span>
          <span>No signup. Nothing leaves your browser.</span>
        </div>
      </div>
    </section>

    <section class="vibe-builder" aria-labelledby="builder-title">
      <div class="container">
        <div class="builder-heading">
          <p class="builder-heading__eyebrow">BUILD YOUR PROMPT</p>
          <h2 id="builder-title">Two choices first. Project context second.</h2>
          <p>
            Start with the direction and screen shape. The generated prompt updates as you make
            each choice.
          </p>
        </div>

        <section class="builder-step" aria-labelledby="vibe-step-title">
          <div class="builder-step__heading">
            <div>
              <p class="builder-step__number">01</p>
              <h3 id="vibe-step-title">How should it feel?</h3>
            </div>
            <p>Choose the closest direction. You can tune the details after the first build.</p>
          </div>

          <div class="vibe-filters" role="group" aria-label="Filter UI directions">
            {categories.map((category) => (
              <button
                class:list={['vibe-filter', { 'is-active': category === 'All' }]}
                type="button"
                data-vibe-filter={category}
                aria-pressed={category === 'All' ? 'true' : 'false'}
              >
                {category}
              </button>
            ))}
          </div>

          <div class="vibe-grid" data-vibe-grid>
            {vibes.map((vibe, index) => (
              <button
                class:list={['vibe-option', { 'is-selected': index === 0 }]}
                type="button"
                data-vibe-option={vibe.id}
                data-vibe={vibe.id}
                data-categories={vibe.categories.join('|')}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="vibe-option__preview" aria-hidden="true">
                  {vibe.id === 'editorial' && (
                    <span class="vibe-mini vibe-mini--editorial">
                      <span class="editorial-mini__masthead">
                        <strong>The Folio</strong><small>VOL II · ISSUE 07</small>
                      </span>
                      <span class="editorial-mini__rule"></span>
                      <span class="editorial-mini__kicker">DESIGN & CULTURE</span>
                      <span class="editorial-mini__headline">The quiet return of restraint.</span>
                      <span class="editorial-mini__deck">
                        Interfaces are learning to trust their content again.
                      </span>
                      <span class="editorial-mini__columns">
                        <i></i><i></i><i></i>
                      </span>
                    </span>
                  )}

                  {vibe.id === 'utility' && (
                    <span class="vibe-mini vibe-mini--utility">
                      <span class="utility-mini__sidebar">
                        <b>PX</b><i></i><i></i><i></i><i></i>
                      </span>
                      <span class="utility-mini__main">
                        <span class="utility-mini__topbar">
                          <strong>Deployments</strong><small>⌘ K</small>
                        </span>
                        <span class="utility-mini__stats">
                          <i><small>Healthy</small><strong>24</strong></i>
                          <i><small>Queued</small><strong>06</strong></i>
                          <i><small>Failed</small><strong>02</strong></i>
                        </span>
                        <span class="utility-mini__table">
                          <i><b></b><em>auth-service</em><small>Healthy</small></i>
                          <i><b></b><em>search-api</em><small>Building</small></i>
                          <i><b></b><em>checkout</em><small>Healthy</small></i>
                        </span>
                      </span>
                    </span>
                  )}

                  {vibe.id === 'warm-consumer' && (
                    <span class="vibe-mini vibe-mini--warm">
                      <span class="warm-mini__date">SATURDAY, MAY 23</span>
                      <span class="warm-mini__hello">Good morning, Alex.</span>
                      <span class="warm-mini__sub">Take it gently today.</span>
                      <span class="warm-mini__card">
                        <span class="warm-mini__card-head">
                          <strong>This week</strong><small>14-day streak</small>
                        </span>
                        <span class="warm-mini__days">
                          <i>✓</i><i>✓</i><i>✓</i><i>–</i><i>✓</i><i class="is-today">S</i><i>S</i>
                        </span>
                        <span class="warm-mini__action">Log today's mood</span>
                      </span>
                    </span>
                  )}

                  {vibe.id === 'sharp-product' && (
                    <span class="vibe-mini vibe-mini--sharp">
                      <span class="sharp-mini__nav">
                        <strong>ACME</strong><small>Docs · Pricing · Login</small>
                      </span>
                      <span class="sharp-mini__badge">NEW IN V3.0</span>
                      <span class="sharp-mini__headline">Build products customers trust.</span>
                      <span class="sharp-mini__deck">Typed APIs for authentication and billing.</span>
                      <span class="sharp-mini__actions"><b>Start building</b><i>View docs</i></span>
                      <span class="sharp-mini__stats"><i>99.99%<small>UPTIME</small></i><i>42ms<small>LATENCY</small></i><i>120k<small>TEAMS</small></i></span>
                    </span>
                  )}

                  {vibe.id === 'soft-saas' && (
                    <span class="vibe-mini vibe-mini--saas">
                      <span class="saas-mini__orb saas-mini__orb--one"></span>
                      <span class="saas-mini__orb saas-mini__orb--two"></span>
                      <span class="saas-mini__badge"><i></i>AI-POWERED · LIVE</span>
                      <span class="saas-mini__headline">Writing copilot</span>
                      <span class="saas-mini__chat">
                        <span class="saas-mini__message">Make this launch note clearer and more direct.</span>
                        <span class="saas-mini__reply">
                          <i></i><b></b><b></b><b class="is-short"></b>
                        </span>
                        <span class="saas-mini__input">Ask Copilot… <strong>↑</strong></span>
                      </span>
                    </span>
                  )}

                  {vibe.id === 'playful' && (
                    <span class="vibe-mini vibe-mini--playful">
                      <span class="playful-mini__confetti"><i></i><i></i><i></i><i></i></span>
                      <span class="playful-mini__badge">QUEST COMPLETE</span>
                      <span class="playful-mini__headline">Level 14!</span>
                      <span class="playful-mini__deck">You learned 8 new words today.</span>
                      <span class="playful-mini__progress"><i></i><small>1440 / 2000 XP</small></span>
                      <span class="playful-mini__actions"><b>Next lesson</b><i>Share</i></span>
                    </span>
                  )}

                  {vibe.id === 'brutalist' && (
                    <span class="vibe-mini vibe-mini--brutalist">
                      <span class="brutal-mini__issue">ISSUE 014 — 06/2026</span>
                      <span class="brutal-mini__headline">SHIP<br />BEFORE<br />YOU'RE READY.</span>
                      <span class="brutal-mini__deck">
                        A bulletin about indie tools and unfinished work.
                      </span>
                      <span class="brutal-mini__actions"><b>SUBSCRIBE →</b><i>READ ARCHIVE</i></span>
                    </span>
                  )}

                  {vibe.id === 'glass-spatial' && (
                    <span class="vibe-mini vibe-mini--glass">
                      <span class="glass-mini__orb glass-mini__orb--one"></span>
                      <span class="glass-mini__orb glass-mini__orb--two"></span>
                      <span class="glass-mini__card">
                        <span class="glass-mini__chip"><i></i>Focus mode · 24 min</span>
                        <span class="glass-mini__headline">Good morning, Maya.</span>
                        <span class="glass-mini__deck">Three quiet hours before your first meeting.</span>
                        <span class="glass-mini__actions"><i>Pause</i><b>Extend +15</b></span>
                      </span>
                      <span class="glass-mini__dock"><i></i><i></i><i></i><i></i></span>
                    </span>
                  )}
                </span>
                <span class="vibe-option__content">
                  <span class="vibe-option__name">
                    {vibe.name}
                    <span class="vibe-option__check" aria-hidden="true">✓</span>
                  </span>
                  <span class="vibe-option__blurb">{vibe.blurb}</span>
                  <span class="vibe-option__use">{vibe.useFor}</span>
                </span>
              </button>
            ))}
          </div>
        </section>

        <section class="builder-step" aria-labelledby="screen-step-title">
          <div class="builder-step__heading builder-step__heading--carousel">
            <div>
              <p class="builder-step__number">02</p>
              <h3 id="screen-step-title">What kind of screen is it?</h3>
            </div>
            <div class="screen-carousel__controls">
              <button type="button" data-carousel-direction="previous" aria-label="Previous screen type">
                ←
              </button>
              <button type="button" data-carousel-direction="next" aria-label="Next screen type">
                →
              </button>
            </div>
          </div>

          <div
            class="screen-carousel__viewport"
            data-carousel-viewport
          >
            <div
              class="screen-carousel"
              data-screen-carousel
              tabindex="0"
              aria-label="Screen type carousel. Swipe, scroll, or use the arrow buttons."
            >
              {screenTypes.map((screen, index) => (
                <button
                  class:list={['screen-option', { 'is-selected': index === 0 }]}
                  type="button"
                  data-screen-option={screen.id}
                  data-screen={screen.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                <span class="screen-option__preview" aria-hidden="true">
                  <span class="screen-preview__browser">
                    <span></span><span></span><span></span>
                  </span>

                  {screen.id === 'dashboard' && (
                    <span class="screen-preview screen-preview--dashboard">
                      <span class="screen-preview__sidebar"></span>
                      <span class="screen-preview__main">
                        <span class="screen-preview__header"></span>
                        <span class="screen-preview__metrics">
                          <span></span><span></span><span></span>
                        </span>
                        <span class="screen-preview__chart"></span>
                      </span>
                    </span>
                  )}

                  {screen.id === 'single-screen' && (
                    <span class="screen-preview screen-preview--single">
                      <span class="screen-preview__single-title"></span>
                      <span class="screen-preview__single-input"></span>
                      <span class="screen-preview__single-result"></span>
                    </span>
                  )}

                  {screen.id === 'form-wizard' && (
                    <span class="screen-preview screen-preview--form">
                      <span class="screen-preview__progress"><span></span></span>
                      <span class="screen-preview__form-title"></span>
                      <span class="screen-preview__field"></span>
                      <span class="screen-preview__field"></span>
                      <span class="screen-preview__form-action"></span>
                    </span>
                  )}

                  {screen.id === 'list-feed' && (
                    <span class="screen-preview screen-preview--list">
                      <span class="screen-preview__filters"></span>
                      <span class="screen-preview__row"><i></i><b></b></span>
                      <span class="screen-preview__row"><i></i><b></b></span>
                      <span class="screen-preview__row"><i></i><b></b></span>
                    </span>
                  )}

                  {screen.id === 'reading' && (
                    <span class="screen-preview screen-preview--reading">
                      <span class="screen-preview__reading-kicker"></span>
                      <span class="screen-preview__reading-title"></span>
                      <span class="screen-preview__reading-copy"></span>
                      <span class="screen-preview__reading-copy screen-preview__reading-copy--short"></span>
                    </span>
                  )}

                  {screen.id === 'landing' && (
                    <span class="screen-preview screen-preview--landing">
                      <span class="screen-preview__landing-nav"></span>
                      <span class="screen-preview__landing-title"></span>
                      <span class="screen-preview__landing-copy"></span>
                      <span class="screen-preview__landing-cta"></span>
                      <span class="screen-preview__landing-cards">
                        <span></span><span></span><span></span>
                      </span>
                    </span>
                  )}
                </span>
                <span class="screen-option__content">
                  <span class="screen-option__name">
                    {screen.name}
                    <span class="screen-option__check" aria-hidden="true">✓</span>
                  </span>
                  <span class="screen-option__description">{screen.description}</span>
                  <span class="screen-option__use">Best for: {screen.useFor}</span>
                </span>
                </button>
              ))}
            </div>
          </div>

          <div class="screen-carousel__footer">
            <p class="screen-carousel__status" data-carousel-status aria-live="polite">
              1 of {screenTypes.length} · {defaultScreen.name}
            </p>
            <div class="screen-carousel__dots" aria-label="Choose a screen type">
              {screenTypes.map((screen, index) => (
                <button
                  class:list={['screen-carousel__dot', { 'is-active': index === 0 }]}
                  type="button"
                  data-screen-dot={screen.id}
                  aria-label={`Show ${screen.name}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                ></button>
              ))}
            </div>
            <p class="screen-carousel__hint">Swipe, scroll, or use the arrows</p>
          </div>
        </section>

        <section class="builder-step" aria-labelledby="context-step-title">
          <div class="builder-step__heading">
            <div>
              <p class="builder-step__number">03</p>
              <h3 id="context-step-title">Add the project context.</h3>
            </div>
            <p>Optional, but this is what turns a reusable direction into your product.</p>
          </div>

          <div class="project-fields">
            <label class="project-field">
              <span>Project name</span>
              <input
                type="text"
                data-project-name
                placeholder="e.g. Personal finance tracker"
                autocomplete="off"
              />
            </label>

            <label class="project-field">
              <span>Implementation stack</span>
              <select data-stack>
                {stackOptions.map((stack) => (
                  <option value={stack.id}>{stack.name}</option>
                ))}
              </select>
            </label>

            <label class="project-field project-field--wide">
              <span>What are you building?</span>
              <textarea
                data-project-description
                rows="4"
                placeholder="A personal finance tool for young professionals to track spending, understand monthly patterns, and set simple budgets."
              ></textarea>
            </label>
          </div>
        </section>

        <section class="builder-step builder-step--prompt" aria-labelledby="prompt-step-title">
          <div class="builder-step__heading builder-step__heading--prompt">
            <div>
              <p class="builder-step__number">04</p>
              <h3 id="prompt-step-title">Copy the prompt.</h3>
            </div>
            <label class="prompt-detail">
              <span>Prompt detail</span>
              <select data-prompt-mode-select>
                <option value="compact">Lean · recommended</option>
                <option value="full">Detailed guardrails</option>
              </select>
            </label>
          </div>

          <div class="prompt-output">
            <div class="prompt-output__meta">
              <div class="prompt-output__selections">
                <span data-selected-vibe>{defaultVibe.name}</span>
                <span data-selected-screen>{defaultScreen.name}</span>
                <span data-token-estimate>≈ {Math.ceil(defaultPrompt.length / 4)} tokens</span>
              </div>
              <div class="prompt-output__actions">
                <button class="prompt-copy" type="button" data-copy-generated>
                  <span data-main-copy-label>Copy prompt</span>
                </button>
              </div>
            </div>
            <pre class="prompt-output__pre" data-no-copy><code data-generated-prompt>{defaultPrompt}</code></pre>
            <p class="prompt-output__status" data-copy-status aria-live="polite"></p>
          </div>
        </section>
      </div>
    </section>

    <section class="vibe-reference" aria-labelledby="reference-title">
      <div class="container">
        <div class="section-heading">
          <p class="section-heading__eyebrow">DETAILED REFERENCE</p>
          <h2 id="reference-title">Need to compare the directions more closely?</h2>
          <p>
            The builder above is for choosing quickly. These notes show the references and full
            design specification behind each direction.
          </p>
        </div>

        <div class="reference-list">
          {vibes.map((vibe) => (
            <article class="reference-item" id={vibe.id}>
              <div class="reference-item__summary">
                <div class="reference-item__identity">
                  <span
                    class="reference-item__swatch"
                    data-vibe-swatch={vibe.id}
                    aria-hidden="true"
                  ></span>
                  <div>
                    <h3><a href={`#${vibe.id}`}>{vibe.name}</a></h3>
                    <p>{vibe.blurb}</p>
                  </div>
                </div>
              </div>

              <p class="reference-item__use"><strong>Best for:</strong> {vibe.useFor}</p>
              <ul class="reference-item__brands" aria-label={`${vibe.name} references`}>
                {vibe.references.map((reference) => <li>{reference}</li>)}
              </ul>

              <details class="reference-item__details">
                <summary>Read the design specification</summary>
                <pre data-no-copy><code>{vibe.designSystem}</code></pre>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="playground-panel">
      <div class="container">
        <div class="playground-panel__inner">
          <div>
            <p class="playground-panel__eyebrow">FULL COMPONENT PLAYGROUND</p>
            <h2>Inspect every direction across a complete interface.</h2>
            <p>
              The standalone reference includes larger page examples, component states, responsive
              layouts, and interactive details. It is useful once you have narrowed the choice.
            </p>
          </div>
          <a href="/ui-vibes-reference.html" target="_blank" rel="noopener noreferrer">
            Open the full visual reference ↗
          </a>
        </div>
      </div>
    </section>

    <section class="vibes-footer">
      <div class="container">
        <p>
          Missing a useful direction? Send it to me on
          <a href="https://twitter.com/Prince_Jain17" target="_blank" rel="noopener noreferrer">
            Twitter
          </a>
          or
          <a
            href="https://www.linkedin.com/in/princejain17/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .vibes-page {
    overflow: hidden;
  }

  .vibes-hero {
    padding: var(--space-16) 0 var(--space-12);
    background: var(--gradient-glow);
  }
  .vibes-hero__eyebrow,
  .builder-heading__eyebrow,
  .section-heading__eyebrow,
  .playground-panel__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .vibes-hero__title {
    max-width: 820px;
    margin-bottom: var(--space-4);
    color: var(--gray-900);
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .vibes-hero__subtitle {
    max-width: 720px;
    color: var(--gray-600);
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .vibes-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--gray-500);
    font-size: var(--text-sm);
  }
  .vibes-hero__meta a {
    color: var(--gray-800);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .vibes-hero__meta a:hover {
    color: var(--color-accent);
  }

  .vibe-builder {
    padding: var(--space-12) 0 var(--space-24);
  }
  .builder-heading,
  .section-heading {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .builder-heading h2,
  .section-heading h2,
  .playground-panel h2 {
    margin-bottom: var(--space-3);
    color: var(--gray-900);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.15;
  }
  .builder-heading > p:last-child,
  .section-heading > p:last-child,
  .playground-panel p {
    color: var(--gray-600);
    line-height: 1.65;
  }

  .builder-step {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--gray-200);
  }
  .builder-step__heading {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .builder-step__heading > div:first-child {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .builder-step__heading h3 {
    color: var(--gray-900);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }
  .builder-step__heading > p {
    max-width: 560px;
    color: var(--gray-500);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .builder-step__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .vibe-filters {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .vibe-filters::-webkit-scrollbar {
    display: none;
  }
  .vibe-filter {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-full);
    background: white;
    color: var(--gray-600);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }
  .vibe-filter:hover {
    border-color: var(--gray-500);
    color: var(--gray-900);
  }
  .vibe-filter.is-active {
    border-color: var(--gray-900);
    background: var(--gray-900);
    color: white;
  }

  .vibe-grid {
    display: grid;
    gap: var(--space-4);
  }
  .vibe-option {
    display: grid;
    grid-template-rows: 220px 1fr;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    background: white;
    color: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .vibe-option:hover {
    transform: translateY(-2px);
    border-color: var(--gray-400);
