  );
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-vibe-filter]')
  );
  const screenDots = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-screen-dot]')
  );
  const carouselButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]')
  );
  const carousel = document.querySelector<HTMLElement>('[data-screen-carousel]');
  const generatedPrompt = document.querySelector<HTMLElement>('[data-generated-prompt]');
  const selectedVibe = document.querySelector<HTMLElement>('[data-selected-vibe]');
  const selectedScreen = document.querySelector<HTMLElement>('[data-selected-screen]');
  const tokenEstimate = document.querySelector<HTMLElement>('[data-token-estimate]');
  const carouselStatus = document.querySelector<HTMLElement>('[data-carousel-status]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  const mainCopyLabel = document.querySelector<HTMLElement>('[data-main-copy-label]');
  const projectNameInput = document.querySelector<HTMLInputElement>('[data-project-name]');
  const descriptionInput =
    document.querySelector<HTMLTextAreaElement>('[data-project-description]');
  const stackSelect = document.querySelector<HTMLSelectElement>('[data-stack]');
  const promptModeSelect =
    document.querySelector<HTMLSelectElement>('[data-prompt-mode-select]');

  function getActiveVibe() {
    return vibes.find((vibe) => vibe.id === builderState.vibeId) ?? vibes[0];
  }

  function getActiveScreen() {
    return (
      screenTypes.find((screen) => screen.id === builderState.screenTypeId) ??
      screenTypes[0]
    );
  }

  function getPromptOptions() {
    return {
      projectName: builderState.projectName,
      description: builderState.description,
      screenTypeId: builderState.screenTypeId,
      stackId: builderState.stackId,
    };
  }

  function currentPrompt(): string {
    const vibe = getActiveVibe();
    return builderState.mode === 'full'
      ? buildFullPrompt(vibe, getPromptOptions())
      : buildCompactPrompt(vibe, getPromptOptions());
  }

  function setPressedState(
    buttons: HTMLButtonElement[],
    selectedValue: string,
    attribute: 'vibeOption' | 'screenOption' | 'promptMode'
  ) {
    buttons.forEach((button) => {
      const isSelected = button.dataset[attribute] === selectedValue;
      button.classList.toggle('is-selected', isSelected);
      button.classList.toggle('is-active', isSelected);
      button.setAttribute('aria-pressed', String(isSelected));
    });
  }

  function renderPrompt() {
    const prompt = currentPrompt();
    const vibe = getActiveVibe();
    const screen = getActiveScreen();
    if (generatedPrompt) generatedPrompt.textContent = prompt;
    if (selectedVibe) selectedVibe.textContent = vibe.name;
    if (selectedScreen) selectedScreen.textContent = screen.name;
    if (tokenEstimate) tokenEstimate.textContent = `≈ ${Math.ceil(prompt.length / 4)} tokens`;
    if (mainCopyLabel) mainCopyLabel.textContent = 'Copy prompt';

    const screenIndex = screenTypes.findIndex((item) => item.id === screen.id);
    if (carouselStatus) {
      carouselStatus.textContent = `${screenIndex + 1} of ${screenTypes.length} · ${screen.name}`;
    }
    screenDots.forEach((dot) => {
      const isSelected = dot.dataset.screenDot === screen.id;
      dot.classList.toggle('is-active', isSelected);
      dot.setAttribute('aria-pressed', String(isSelected));
    });
    carouselButtons.forEach((button) => {
      const direction = button.dataset.carouselDirection;
      button.disabled =
        (direction === 'previous' && screenIndex === 0) ||
        (direction === 'next' && screenIndex === screenTypes.length - 1);
    });
  }

  function selectVibe(vibeId: string) {
    builderState.vibeId = vibeId;
    setPressedState(vibeButtons, vibeId, 'vibeOption');
    renderPrompt();
  }

  function scrollScreenIntoView(screenTypeId: string) {
    if (!carousel) return;
    const button = screenButtons.find(
      (screenButton) => screenButton.dataset.screenOption === screenTypeId
    );
    if (!button) return;
    const targetLeft =
      button.offsetLeft - carousel.offsetLeft - (carousel.clientWidth - button.offsetWidth) / 2;
    carousel.scrollTo({ left: targetLeft, behavior: 'smooth' });
  }

  function selectScreen(screenTypeId: string, shouldScroll = false) {
    builderState.screenTypeId = screenTypeId;
    setPressedState(screenButtons, screenTypeId, 'screenOption');
    renderPrompt();

    if (shouldScroll) scrollScreenIntoView(screenTypeId);
  }

  function selectPromptMode(mode: PromptMode) {
    builderState.mode = mode;
    renderPrompt();
  }

  function setFilter(filter: string) {
    filterButtons.forEach((button) => {
      const isSelected = button.dataset.vibeFilter === filter;
      button.classList.toggle('is-active', isSelected);
      button.setAttribute('aria-pressed', String(isSelected));
    });

    vibeButtons.forEach((button) => {
      const categories = button.dataset.categories?.split('|') ?? [];
      button.hidden = filter !== 'All' && !categories.includes(filter);
    });

    const activeButton = vibeButtons.find(
      (button) => button.dataset.vibeOption === builderState.vibeId
    );
    if (activeButton?.hidden) {
      const firstVisible = vibeButtons.find((button) => !button.hidden);
      const nextVibeId = firstVisible?.dataset.vibeOption;
      if (nextVibeId) selectVibe(nextVibeId);
    }
  }

  function moveCarousel(direction: number) {
    const currentIndex = screenTypes.findIndex(
      (screen) => screen.id === builderState.screenTypeId
    );
    const nextIndex = Math.max(
      0,
      Math.min(screenTypes.length - 1, currentIndex + direction)
    );
    selectScreen(screenTypes[nextIndex].id, true);
  }

  async function copyText(
    text: string,
    successMessage: string,
    button?: HTMLButtonElement
  ) {
    try {
      await navigator.clipboard.writeText(text);
      if (copyStatus) copyStatus.textContent = successMessage;
      const feedbackTarget =
        button?.querySelector<HTMLElement>('[data-main-copy-label]') ?? button;
      const original = feedbackTarget?.textContent;
      if (feedbackTarget) feedbackTarget.textContent = 'Copied ✓';
      window.setTimeout(() => {
        if (feedbackTarget && original) feedbackTarget.textContent = original;
        if (copyStatus?.textContent === successMessage) copyStatus.textContent = '';
      }, 1800);
    } catch {
      if (copyStatus) {
        copyStatus.textContent =
          'Clipboard access was blocked. Expand the prompt and copy it manually.';
      }
    }
  }

  vibeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const vibeId = button.dataset.vibeOption;
      if (vibeId) selectVibe(vibeId);
    });
  });

  screenButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const screenTypeId = button.dataset.screenOption;
      if (screenTypeId) selectScreen(screenTypeId, true);
    });
  });

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.vibeFilter;
      if (filter) setFilter(filter);
    });
  });

  screenDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const screenTypeId = dot.dataset.screenDot;
      if (screenTypeId) selectScreen(screenTypeId, true);
    });
  });

  carouselButtons.forEach((button) => {
    button.addEventListener('click', () => {
      moveCarousel(button.dataset.carouselDirection === 'next' ? 1 : -1);
    });
  });

  carousel?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    moveCarousel(event.key === 'ArrowRight' ? 1 : -1);
  });

  let carouselScrollTimer = 0;
  carousel?.addEventListener('scroll', () => {
    window.clearTimeout(carouselScrollTimer);
    carouselScrollTimer = window.setTimeout(() => {
      if (!carousel) return;
      const viewportCenter = carousel.scrollLeft + carousel.clientWidth / 2;
      const closest = screenButtons.reduce<HTMLButtonElement | null>((best, button) => {
        const buttonCenter = button.offsetLeft + button.offsetWidth / 2;
        if (!best) return button;
        const bestCenter = best.offsetLeft + best.offsetWidth / 2;
        return Math.abs(buttonCenter - viewportCenter) < Math.abs(bestCenter - viewportCenter)
          ? button
          : best;
      }, null);
      const screenTypeId = closest?.dataset.screenOption;
      if (screenTypeId && screenTypeId !== builderState.screenTypeId) {
        selectScreen(screenTypeId);
      }
    }, 120);
  });

  projectNameInput?.addEventListener('input', () => {
    builderState.projectName = projectNameInput.value;
    renderPrompt();
  });
  descriptionInput?.addEventListener('input', () => {
    builderState.description = descriptionInput.value;
    renderPrompt();
  });
  stackSelect?.addEventListener('change', () => {
    builderState.stackId = stackSelect.value;
    renderPrompt();
  });
  promptModeSelect?.addEventListener('change', () => {
    const mode = promptModeSelect.value;
    if (mode === 'compact' || mode === 'full') selectPromptMode(mode);
  });

  document.querySelector<HTMLButtonElement>('[data-copy-generated]')?.addEventListener(
    'click',
    (event) => {
      void copyText(
        currentPrompt(),
        `${builderState.mode === 'full' ? 'Full' : 'Compact'} prompt copied.`,
        event.currentTarget as HTMLButtonElement
      );
    }
  );

  renderPrompt();
</script>
