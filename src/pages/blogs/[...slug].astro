---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogTOC from '../../components/BlogTOC.astro';
import ShareIcon from '../../components/ShareIcon.astro';
import { calculateReadingTime, countWords } from '../../utils/readingTime';

// Module-level cache — computed once per build, reused across all post pages.
// Without this we were re-fetching the collection and re-running reading-time
// for every related-posts lookup on every page (N² over the blog).
const _allPostsSorted = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const _readingTimeById = new Map(
  _allPostsSorted.map(p => [p.id, calculateReadingTime(p.body ?? '')])
);
const _wordCountById = new Map(
  _allPostsSorted.map(p => [p.id, countWords(p.body ?? '')])
);

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

const readingTime = _readingTimeById.get(post.id) ?? calculateReadingTime(post.body ?? '');
const tags = post.data.tags;
const wordCount = _wordCountById.get(post.id) ?? countWords(post.body ?? '');

// Find related posts by shared-tag count, excluding current and zero-overlap.
const relatedPosts = _allPostsSorted
  .filter(p => p.id !== post.id)
  .map(p => ({
    ...p,
    readingTime: _readingTimeById.get(p.id) ?? 1,
    tags: p.data.tags,
    score: p.data.tags.filter(t => tags.includes(t)).length,
  }))
  .filter(p => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2);

// Share URLs
const siteUrl = "https://princejain.me";
const shareUrl = `${siteUrl}/blogs/${post.id}/`;
const shareTitle = encodeURIComponent(post.data.title);
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${encodeURIComponent(shareUrl)}&via=Prince_Jain17`;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

// SEO: Determine OG image (ogImage > heroImage > profile photo fallback)
const ogImage = post.data.ogImage
  ? `${siteUrl}${post.data.ogImage}`
  : post.data.heroImage
    ? `${siteUrl}${post.data.heroImage}`
    : `${siteUrl}/profile-photo-1.webp`;

// SEO: BlogPosting structured data
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString() }
    : {}),
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: "Prince Jain",
    url: siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: "Prince Jain",
    url: siteUrl,
    image: `${siteUrl}/profile-photo-1.webp`,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": shareUrl,
  },
  keywords: tags,
  wordCount,
  image: ogImage,
  url: shareUrl,
};

// SEO: Breadcrumbs
const breadcrumbs = [
  { name: "Home", url: siteUrl },
  { name: "Blog", url: `${siteUrl}/blogs/` },
  { name: post.data.title },
];
---

<BaseLayout
  title={`${post.data.title} | Prince Jain`}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`Cover image for ${post.data.title}`}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  articleTags={tags}
  breadcrumbs={breadcrumbs}
  extraSchema={blogPostingSchema}
>
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="reading-progress"></div>

  <!-- Navigation -->
  <nav class="blog-nav">
    <div class="container">
      <a href="/blogs" class="blog-nav__back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Blog
      </a>
    </div>
  </nav>

  <BlogTOC headings={headings} tag={tags[0]} />

  <article class="blog-post">
    <!-- Hero Header -->
    <header class="blog-post__hero">
      <div class="container">
        <div class="blog-post__header animate-fade-up">
          <!-- Meta -->
          <div class="blog-post__meta">
            <time datetime={post.data.pubDate?.toISOString()}>
              {post.data.pubDate?.toLocaleDateString('en-us', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <span class="blog-post__separator">·</span>
            <span class="blog-post__reading-time">{readingTime} min read</span>
          </div>

          <!-- Title -->
          <h1 class="blog-post__title">{post.data.title}</h1>

          <!-- Description -->
          {post.data.description && (
            <p class="blog-post__description">{post.data.description}</p>
          )}

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="blog-post__tags">
              {tags.map((tag) => (
                <span class="blog-post__tag">{tag}</span>
              ))}
            </div>
          )}

          <!-- Share buttons -->
          <div class="blog-post__share">
            <span class="blog-post__share-label">Share:</span>
            <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="blog-post__share-btn" aria-label="Share on Twitter">
              <ShareIcon network="twitter" />
            </a>
            <a href={linkedInShareUrl} target="_blank" rel="noopener noreferrer" class="blog-post__share-btn" aria-label="Share on LinkedIn">
              <ShareIcon network="linkedin" />
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="blog-post__body">
      <div class="container prose">
        <div class="blog-post__content animate-fade-up animate-delay-100">
          <Content />
        </div>
      </div>
    </div>

    <!-- Footer with share and related -->
    <footer class="blog-post__footer">
      <div class="container">
        <!-- Share CTA -->
        <div class="blog-post__share-cta animate-fade-up">
          <p>Enjoyed this article? Share it with others!</p>
          <div class="blog-post__share-buttons">
            <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <ShareIcon network="twitter" size={16} />
              Share on X
            </a>
            <a href={linkedInShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <ShareIcon network="linkedin" size={16} />
              Share on LinkedIn
            </a>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <div class="related-posts animate-fade-up animate-delay-150">
            <h2 class="related-posts__title">Continue Reading</h2>
            <div class="related-posts__grid">
              {relatedPosts.map((relatedPost) => (
                <BlogCard
                  title={relatedPost.data.title}
                  description={relatedPost.data.description}
                  pubDate={relatedPost.data.pubDate || new Date()}
                  slug={relatedPost.id}
                  readingTime={relatedPost.readingTime}
                  tags={relatedPost.tags}
                />
              ))}
            </div>
          </div>
        )}
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Reading Progress Bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-secondary));
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  /* Navigation */
  .blog-nav {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--gray-100);
  }

  .blog-nav__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gray-600);
    transition: all var(--transition-fast);
  }

  .blog-nav__back:hover {
    color: var(--color-accent);
  }

  .blog-nav__back svg {
    transition: transform var(--transition-bounce);
  }

  .blog-nav__back:hover svg {
    transform: translateX(-4px);
  }

  /* Hero Header */
  .blog-post__hero {
    padding: var(--space-12) 0 var(--space-8);
    position: relative;
  }

  .blog-post__header {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--gray-500);
    font-family: var(--font-mono);
    margin-bottom: var(--space-4);
  }

  .blog-post__separator {
    color: var(--gray-300);
  }

  .blog-post__reading-time {
    color: var(--gray-400);
  }

  .blog-post__title {
    font-size: var(--text-4xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--gray-900);
    font-weight: 600;
  }

  .blog-post__description {
    font-size: var(--text-xl);
    color: var(--gray-600);
    line-height: 1.5;
    margin-bottom: var(--space-6);
    max-width: 60ch;
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .blog-post__tag {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: linear-gradient(135deg, var(--color-accent-glow), hsla(340, 80%, 55%, 0.1));
    color: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .blog-post__share {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .blog-post__share-label {
    font-size: var(--text-sm);
    color: var(--gray-500);
  }

  .blog-post__share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--glass-bg);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition-fast);
  }

  .blog-post__share-btn:hover {
    background: var(--gray-900);
    border-color: var(--gray-900);
    color: white;
    transform: translateY(-2px);
  }

  /* Content Body */
  .blog-post__body {
    padding: var(--space-8) 0;
  }

  .blog-post__content {
    max-width: var(--content-width);
  }

  /* Typography for Markdown Content — em-based modular scale (1.25×) so
     headings scale with body across breakpoints. */
  .blog-post__content :global(h2) {
    font-size: 1.56em;     /* body × 1.25² */
    line-height: 1.25;
    font-weight: 600;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .blog-post__content :global(h3) {
    font-size: 1.25em;     /* body × 1.25 */
    line-height: 1.3;
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .blog-post__content :global(h4) {
    font-size: 1em;
    line-height: 1.4;
    font-weight: 700;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .blog-post__content :global(p) {
    margin-bottom: 1.25em;
    line-height: 1.7;
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .blog-post__content :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.7;
  }

  .blog-post__content :global(li > ul),
  .blog-post__content :global(li > ol) {
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .blog-post__content :global(blockquote) {
    position: relative;
    padding: var(--space-4) var(--space-6);
    margin: var(--space-8) 0;
    background: linear-gradient(to right, var(--color-accent-glow), transparent);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--gray-700);
  }

  .blog-post__content :global(blockquote p) {
    margin-bottom: 0;
  }

  .blog-post__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--gray-100);
    padding: 0.2em 0.5em;
    border-radius: var(--radius-sm);
    color: var(--gray-800);
  }

  .blog-post__content :global(pre) {
    background-color: var(--gray-900);
    color: var(--gray-100);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: var(--space-6) 0;
    box-shadow: var(--shadow-lg);
  }

  .blog-post__content :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: inherit;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .blog-post__content :global(img) {
    border-radius: var(--radius-lg);
    margin: var(--space-8) auto;
    box-shadow: var(--shadow-lg);
  }

  .blog-post__content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-glow);
    text-underline-offset: 3px;
    transition: all var(--transition-fast);
  }

  .blog-post__content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .blog-post__content :global(hr) {
    border: none;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gray-200), transparent);
    margin: var(--space-12) 0;
  }

  .blog-post__content :global(strong) {
    font-weight: 600;
    color: var(--gray-900);
  }

  .blog-post__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-sm);
  }

  .blog-post__content :global(th),
  .blog-post__content :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--gray-200);
  }

  .blog-post__content :global(th) {
    font-weight: 600;
    background-color: var(--gray-50);
  }

  /* Footer */
  .blog-post__footer {
    padding: var(--space-12) 0 var(--space-24);
    border-top: 1px solid var(--gray-100);
    margin-top: var(--space-8);
  }

  .blog-post__share-cta {
    max-width: var(--content-width);
    margin: 0 auto var(--space-12);
    text-align: center;
    padding: var(--space-8);
    background: linear-gradient(180deg, var(--gray-50), transparent);
    border-radius: var(--radius-lg);
  }

  .blog-post__share-cta p {
    font-size: var(--text-lg);
    color: var(--gray-600);
    margin-bottom: var(--space-4);
  }

  .blog-post__share-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .blog-post__share-buttons .btn {
    gap: var(--space-2);
  }

  .blog-post__share-buttons svg {
    width: 16px;
    height: 16px;
  }

  /* Related Posts */
  .related-posts {
    max-width: var(--content-width);
    margin: var(--space-8) auto 0;
  }

  .related-posts__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
    position: relative;
    display: inline-block;
  }

  .related-posts__title::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 2px;
  }

  .related-posts__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .blog-post__hero {
      padding: var(--space-8) 0 var(--space-6);
    }

    .blog-post__title {
      font-size: var(--text-3xl);
    }

    .blog-post__description {
      font-size: var(--text-lg);
    }

    .blog-post__share-buttons {
      flex-direction: column;
    }

    .related-posts__grid {
      grid-template-columns: 1fr;
    }

    .blog-post__content :global(h2) {
      margin-top: var(--space-8);
    }
  }
</style>

<script>
  import { initReadingProgress } from '../../scripts/readingProgress';
  import { initBlogToc } from '../../scripts/blogToc';
  initReadingProgress();
  initBlogToc();
</script>
