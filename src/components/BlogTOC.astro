---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  tag?: string;
}

const { headings, tag } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tagSlug = tag ? tag.toLowerCase().replace(/\s+/g, '-') : 'default';
---

{tocHeadings.length > 0 && (
  <nav
    class="blog-toc"
    data-tag={tagSlug}
    aria-label="Table of contents"
  >
    <div class="blog-toc__inner">
      <div class="blog-toc__track">
        <div class="blog-toc__track-bg"></div>
        <div class="blog-toc__track-indicator"></div>
      </div>
      <ul class="blog-toc__items">
        <li>
          <a href="#" class="blog-toc__link blog-toc__link--top is-active" data-toc-top>
            Top
          </a>
        </li>
        {tocHeadings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={['blog-toc__link', { 'blog-toc__link--nested': h.depth === 3 }]}
              data-toc-link={h.slug}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  .blog-toc {
    display: none;
  }

  @media (min-width: 1400px) {
    .blog-toc {
      display: block;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      left: max(var(--space-8), calc((100vw - var(--content-width)) / 2 - 240px));
      width: 200px;
      z-index: 10;
      max-height: 65vh;
      overflow-y: auto;
      scrollbar-width: none;
    }

    .blog-toc::-webkit-scrollbar {
      display: none;
    }
  }

  @media (min-width: 1800px) {
    .blog-toc {
      left: max(var(--space-8), calc((100vw - var(--content-width)) / 2 - 300px));
    }
  }

  .blog-toc__inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .blog-toc__track {
    position: relative;
    width: 2px;
    flex-shrink: 0;
    align-self: stretch;
    min-height: 100%;
  }

  .blog-toc__track-bg {
    position: absolute;
    inset: 0;
    background: var(--gray-200);
    border-radius: 1px;
  }

  .blog-toc__track-indicator {
    position: absolute;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--toc-color, var(--color-accent));
    border-radius: 1px;
    transform: translateY(0);
    transition:
      transform 200ms cubic-bezier(0.4, 0, 0.2, 1),
      height 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-toc__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    min-width: 0;
  }

  .blog-toc__items li {
    margin: 0;
    padding: 0;
  }

  .blog-toc__link {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--gray-900);
    opacity: 0.4;
    text-decoration: none;
    transition: opacity 150ms ease, color 150ms ease;
    text-align: left;
  }

  .blog-toc__link--nested {
    padding-left: var(--space-3);
    font-size: 0.8125rem;
  }

  .blog-toc__link:hover {
    opacity: 0.75;
  }

  .blog-toc__link.is-active {
    opacity: 1;
    color: var(--toc-color, var(--color-accent));
    font-weight: 500;
  }

  /* Per-tag active colors */
  .blog-toc[data-tag="ai"],
  .blog-toc[data-tag="vibe-coding"] {
    --toc-color: hsl(12, 70%, 45%);
  }
  .blog-toc[data-tag="product"],
  .blog-toc[data-tag="career"] {
    --toc-color: hsl(232, 50%, 48%);
  }
  .blog-toc[data-tag="impact"],
  .blog-toc[data-tag="growth"] {
    --toc-color: hsl(160, 50%, 32%);
  }
  .blog-toc[data-tag="building"],
  .blog-toc[data-tag="automation"] {
    --toc-color: hsl(28, 80%, 42%);
  }
  .blog-toc[data-tag="tech"],
  .blog-toc[data-tag="engineering"] {
    --toc-color: hsl(215, 30%, 38%);
  }
  .blog-toc[data-tag="design"],
  .blog-toc[data-tag="platform"],
  .blog-toc[data-tag="seo"] {
    --toc-color: hsl(330, 55%, 45%);
  }
</style>
