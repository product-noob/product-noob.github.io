---
/**
 * SelectedWork — Homepage work timeline with wave divider.
 * Receives work highlights via props and renders a vertical timeline
 * with scroll-triggered reveal animations.
 */
import type { WorkHighlight } from '../../data/works';
import ExternalLink from '../ExternalLink.astro';

interface Props {
  items: WorkHighlight[];
}

const { items } = Astro.props;
---

<!-- Selected Work Section - Vertical Timeline -->
<section class="timeline-section">
  <div class="container timeline-container">
    <div class="timeline-header">
      <h2 class="timeline-header__title">Selected Work</h2>
      <p class="timeline-header__subtitle">
        Highlights from my work at Flipkart and Paytm, focusing on AI products and growth.
      </p>
    </div>

    <div class="timeline-wrapper">
      <div class="timeline-entries">
        {items.map((work, index) => {
          const isExternal = work.link?.startsWith('http');
          const cueLabel = work.linkText || 'Learn more';
          const inner = (
            <>
              <div class="timeline-icon-col">
                <div class="timeline-dot">
                  <img src={work.workIcon} alt="" class="timeline-dot__icon" width="32" height="32" loading="lazy" />
                </div>
              </div>
              <div class="timeline-content">
                <p class="timeline-meta">
                  <span class="timeline-meta__year">{work.title}</span>
                  <span class="timeline-meta__sep" aria-hidden="true">·</span>
                  <span class="timeline-meta__role">{work.role}</span>
                </p>
                <h3 class="timeline-title">{work.company}</h3>
                <p class="timeline-description">{work.highlight}</p>
                {work.link && (
                  <span class="timeline-cue">
                    {cueLabel}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14M13 5l7 7-7 7"/>
                    </svg>
                  </span>
                )}
              </div>
            </>
          );

          const entryStyle = `--entry-color: ${work.accentColor}; --entry-delay: ${index * 0.08}s`;

          if (!work.link) {
            return (
              <div class="timeline-entry" style={entryStyle}>{inner}</div>
            );
          }

          if (isExternal) {
            return (
              <ExternalLink href={work.link} class="timeline-entry timeline-entry--link" style={entryStyle}>
                {inner}
              </ExternalLink>
            );
          }

          return (
            <a href={work.link} class="timeline-entry timeline-entry--link" style={entryStyle}>
              {inner}
            </a>
          );
        })}
      </div>

      <div class="timeline-cta">
        <a href="/work" class="btn-outline">
          View all work experience
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const revealTimelineEntries = () => {
    const entries = document.querySelectorAll('.timeline-entry');

    if (!('IntersectionObserver' in window)) {
      entries.forEach((entry) => entry.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (observed) => {
        observed.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: '0px 0px -10% 0px',
      }
    );

    entries.forEach((entry) => observer.observe(entry));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', revealTimelineEntries);
  } else {
    revealTimelineEntries();
  }
</script>

<style>
  /* Wave Dividers */
  .wave-divider {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 10;
  }

  .wave-divider svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100px;
  }

  .wave-divider--warm {
    color: #fff8f5;
    margin-top: -1px;
  }

  /* Timeline Section */
  .timeline-section {
    padding: var(--space-12) 0 var(--space-24);
    background: var(--bg-warm);
    position: relative;
  }

  @media (min-width: 768px) {
    .timeline-section {
      padding: var(--space-16) 0 var(--space-24);
    }
  }

  .timeline-container {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  @media (min-width: 768px) {
    .timeline-container {
      padding: 0 var(--space-12);
    }
  }

  .timeline-header {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto var(--space-12);
  }

  .timeline-header__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--gray-900);
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .timeline-header__title { font-size: var(--text-5xl); }
  }

  .timeline-header__subtitle {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--gray-500);
    margin: 0;
  }

  /* Timeline Wrapper */
  .timeline-wrapper {
    max-width: 48rem;
    margin: 0 auto;
  }

  .timeline-entries {
    position: relative;
  }

  /* Timeline Entry — flexbox layout: icon column + content column */
  .timeline-entry {
    position: relative;
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    text-decoration: none;
    color: inherit;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--entry-delay);
  }

  @media (min-width: 768px) {
    .timeline-entry {
      gap: var(--space-5);
      margin-bottom: var(--space-8);
    }
  }

  .timeline-entry:last-child {
    margin-bottom: 0;
  }

  .timeline-entry.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Icon column — fixed width, holds the dot and the connecting line */
  .timeline-icon-col {
    position: relative;
    flex: 0 0 2.5rem;
    width: 2.5rem;
  }

  @media (min-width: 768px) {
    .timeline-icon-col {
      flex-basis: 2.75rem;
      width: 2.75rem;
    }
  }

  /* Connecting line — drawn via ::before, extends from bottom of dot to next entry's dot */
  .timeline-icon-col::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 2.5rem;
    bottom: calc(var(--space-8) * -1);
    width: 2px;
    background: var(--gray-200);
    transform: translateX(-50%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .timeline-icon-col::before {
      top: 2.75rem;
      bottom: calc(var(--space-8) * -1);
    }
  }

  .timeline-entry:last-child .timeline-icon-col::before {
    display: none;
  }

  /* Icon container — tight box, ring carries brand color */
  .timeline-dot {
    position: relative;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    background: white;
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    border: 2px solid var(--entry-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (min-width: 768px) {
    .timeline-dot {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 14px;
    }
  }

  .timeline-entry--link:hover .timeline-dot {
    transform: scale(1.05);
    box-shadow: var(--shadow-md);
  }

  .timeline-dot__icon {
    width: 1.875rem;
    height: 1.875rem;
    object-fit: contain;
    border-radius: 4px;
  }

  @media (min-width: 768px) {
    .timeline-dot__icon {
      width: 2rem;
      height: 2rem;
    }
  }

  /* Content column — takes remaining space */
  .timeline-content {
    flex: 1 1 auto;
    min-width: 0;
    padding-top: 2px;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5ch;
    row-gap: 2px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--gray-500);
    margin: 0 0 var(--space-1);
    line-height: 1.4;
  }

  .timeline-meta__year {
    color: var(--gray-700);
    font-weight: 700;
  }

  .timeline-meta__sep {
    color: var(--gray-400);
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gray-900);
    margin: 0 0 var(--space-2);
    line-height: 1.25;
    transition: color var(--transition-base);
  }

  @media (min-width: 768px) {
    .timeline-title { font-size: 1.375rem; }
  }

  @media (min-width: 1024px) {
    .timeline-title { font-size: 1.5rem; }
  }

  .timeline-entry--link:hover .timeline-title {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .timeline-description {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--gray-600);
    margin: 0 0 var(--space-2);
  }

  .timeline-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gray-500);
    transition: color var(--transition-base);
  }

  .timeline-cue svg {
    transition: transform var(--transition-base);
  }

  .timeline-entry--link:hover .timeline-cue {
    color: var(--color-accent);
  }

  .timeline-entry--link:hover .timeline-cue svg {
    transform: translateX(3px);
  }

  .timeline-cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-entry {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .timeline-cue svg,
    .timeline-dot,
    .timeline-title {
      transition: none;
    }
  }
</style>
