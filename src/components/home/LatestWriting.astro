---
/**
 * LatestWriting — Recent blog posts as a 2-up card grid.
 *
 * Visual system mirrors DigitalGarden / SpeakingEvents:
 *   - Section header sizing (text-4xl mobile, text-5xl desktop)
 *   - Glassmorphic card chrome from project-card-v2 (radius-lg, glass bg,
 *     gray-200 border, shadow-card, lift on hover)
 *   - Type scale calibrated to the rest of the page (no oversized titles)
 */
import type { CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'blog'> & { readingTime: number };

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<section class="writing">
  <div class="container">
    <div class="writing__header">
      <h2 class="writing__title">Latest Writing</h2>
      <p class="writing__subtitle">
        Notes on building AI products, product craft, and the work of being a PM today.
      </p>
    </div>

    <div class="writing__grid">
      {posts.map((post, i) => (
        <a
          class="writing-card"
          href={`/blogs/${post.id}`}
          style={`--card-delay: ${i * 80}ms`}
          data-track="latest_writing"
          data-track-location="home"
        >
          <div class="writing-card__inner">
            {post.data.featured && (
              <span class="writing-card__featured">Featured</span>
            )}
            <p class="writing-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
              <span class="writing-card__sep" aria-hidden="true">·</span>
              <span>{post.readingTime} min read</span>
            </p>
            <h3 class="writing-card__title">{post.data.title}</h3>
            <p class="writing-card__desc">{post.data.description}</p>
            <div class="writing-card__footer">
              <div class="writing-card__tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="writing-card__link">
                Read
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </span>
            </div>
          </div>
          <div class="writing-card__glow"></div>
        </a>
      ))}
    </div>

    <div class="writing__cta">
      <a href="/blogs" class="btn-outline" data-track="latest_writing_all" data-track-location="home">
        Browse all writing
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .writing {
    padding: var(--space-24) 0;
    position: relative;
  }

  /* ── Section header — matches garden/events identity ── */
  .writing__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-12);
  }

  .writing__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--gray-900);
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .writing__title { font-size: var(--text-5xl); }
  }

  .writing__subtitle {
    font-size: var(--text-base);
    color: var(--gray-500);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Grid: 1 col mobile, 2 col tablet+ ── */
  .writing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: 56rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .writing__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  /* ── Card chrome — mirrors project-card-v2 ── */
  .writing-card {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .writing-card__inner {
    position: relative;
    z-index: 1;
    background: var(--glass-bg-heavy);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-base);
  }

  .writing-card__glow {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    opacity: 0;
    z-index: 0;
    transition: opacity var(--transition-base);
    padding: 2px;
  }

  .writing-card:hover {
    transform: translateY(-5px);
  }

  .writing-card:hover .writing-card__inner {
    border-color: transparent;
    box-shadow: var(--shadow-card-hover);
  }

  .writing-card:hover .writing-card__glow {
    opacity: 1;
  }

  /* ── Featured ribbon — top-right of card ── */
  .writing-card__featured {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    padding: 3px var(--space-2);
    background: hsla(28, 100%, 50%, 0.1);
    color: var(--color-accent);
    font-size: var(--text-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-full);
    border: 1px solid hsla(28, 100%, 50%, 0.3);
  }

  /* ── Card content ── */
  .writing-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4ch;
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gray-400);
    margin: 0;
  }

  .writing-card__sep {
    color: var(--gray-300);
  }

  .writing-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--gray-900);
    margin: 0;
    line-height: 1.3;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .writing-card__title { font-size: var(--text-xl); }
  }

  .writing-card__desc {
    font-size: var(--text-sm);
    color: var(--gray-600);
    line-height: 1.55;
    margin: 0;
    /* clamp to 3 lines so cards stay balanced */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    flex-wrap: wrap;
  }

  .writing-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .writing-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--gray-700);
    transition: color var(--transition-fast);
  }

  .writing-card__link svg {
    transition: transform var(--transition-fast);
  }

  .writing-card:hover .writing-card__link {
    color: var(--color-accent);
  }

  .writing-card:hover .writing-card__link svg {
    transform: translate(2px, -2px);
  }

  /* ── Section CTA ── */
  .writing__cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card,
    .writing-card__inner,
    .writing-card__glow,
    .writing-card__link,
    .writing-card__link svg {
      transition: none;
    }
  }
</style>
