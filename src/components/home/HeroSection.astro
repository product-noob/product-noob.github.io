---
/**
 * HeroSection — Homepage hero with rotating profile images.
 * Self-contained: owns its markup, styles, and client-side script.
 */
import { Image } from 'astro:assets';
import ExternalLink from '../ExternalLink.astro';
import profilePhoto1 from '../../assets/profile-photo-1.webp';
import profilePhoto2 from '../../assets/profile-photo-2.webp';
import profilePhoto3 from '../../assets/profile-photo-3.webp';
import profilePhoto4 from '../../assets/profile-photo-4.webp';
---

<section class="hero-v2">
  <div class="container">
    <div class="hero-v2__grid">
      <!-- Left Column - Content -->
      <div class="hero-v2__content">
        <h1 class="hero-v2__headline">
          I build<br>
          <span class="text-accent-primary">AI</span> <span class="text-accent-secondary">Products</span>.
        </h1>

        <p class="hero-v2__intro">
          I'm <strong>Prince Jain</strong> — Group Product Manager at <strong>Flipkart</strong>,<br>
          building 0→1 agentic AI experiences and the next wave of AI-native products.
        </p>

        <div class="hero-v2__cta">
          <a href="/work" class="btn-gradient" data-track="hero_work" data-track-location="hero">
            <span>View my work</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/blogs" class="btn-outline" data-track="hero_blog" data-track-location="hero">
            <span>Read the blog</span>
          </a>
        </div>

        <div class="hero-v2__proof">
        <!-- Companies -->
        <div class="hero-v2__inline-row hero-v2__inline-row--companies">
          <div class="hero-v2__co-row hero-v2__co-row--current">
            <span class="hero-v2__co-text">Currently PM at</span>
            <span class="hero-v2__co-label">Currently at</span>
            <span class="hero-v2__icon-card">
              <img src="/icons/flipkart.svg" alt="Flipkart" class="hero-v2__icon-card-logo" width="36" height="36" />
            </span>
          </div>
          <div class="hero-v2__co-row hero-v2__co-row--previous">
            <span class="hero-v2__co-text">previously at</span>
            <span class="hero-v2__co-label">Previously at</span>
            <span class="hero-v2__icon-card">
              <img src="/icons/paytm.svg" alt="Paytm" class="hero-v2__icon-card-logo" width="36" height="36" />
            </span>
            <span class="hero-v2__co-text">and</span>
            <span class="hero-v2__icon-card">
              <img src="/icons/oracle.svg" alt="Oracle" class="hero-v2__icon-card-logo hero-v2__icon-card-logo--desktop" width="36" height="36" />
              <img src="/icons/oracle-mark.svg" alt="Oracle" class="hero-v2__icon-card-logo hero-v2__icon-card-logo--mobile" width="36" height="36" />
            </span>
          </div>
        </div>

        <!-- Side Projects -->
        <p class="hero-v2__inline-row hero-v2__inline-row--projects">
          <span>Some recent side projects</span>
          <span class="hero-v2__cluster">
            <ExternalLink href="https://pm-vault.princejain.me/" class="hero-v2__cluster-item hero-v2__cluster-item--z3" data-track="side_project_pm_vault" data-track-location="hero">
              <span class="hero-v2__cluster-card">
                <img src="/icons/pm-vault.svg" alt="PM Vault" width="48" height="48" loading="lazy" />
              </span>
              <span class="hero-v2__cluster-tip">PM interview prep tool</span>
              <span class="hero-v2__cluster-name">PM Vault</span>
            </ExternalLink>
            <ExternalLink href="https://whispr.princejain.me/" class="hero-v2__cluster-item hero-v2__cluster-item--stacked hero-v2__cluster-item--z2" data-track="side_project_whispr" data-track-location="hero">
              <span class="hero-v2__cluster-card">
                <img src="/icons/whisprflow.webp" alt="Whisprflow" width="48" height="48" loading="lazy" />
              </span>
              <span class="hero-v2__cluster-tip">Voice-to-text Transcription</span>
              <span class="hero-v2__cluster-name">Whispr</span>
            </ExternalLink>
            <ExternalLink href="https://chromewebstore.google.com/detail/chatgpt-google-meet-summa/kofkiemddfpekcadmaeheonbbkhnclhj" class="hero-v2__cluster-item hero-v2__cluster-item--stacked hero-v2__cluster-item--z1" data-track="side_project_gmeet_summariser" data-track-location="hero">
              <span class="hero-v2__cluster-card">
                <img src="/icons/gmeet-summariser.svg" alt="G-meet Summariser" width="48" height="48" loading="lazy" />
              </span>
              <span class="hero-v2__cluster-tip">AI meeting notes</span>
              <span class="hero-v2__cluster-name">G-Meet</span>
            </ExternalLink>
            <ExternalLink href="https://launchpad.princejain.me/" class="hero-v2__cluster-item hero-v2__cluster-item--stacked hero-v2__cluster-item--z0" data-track="side_project_launchpad" data-track-location="hero">
              <span class="hero-v2__cluster-card">
                <img src="/icons/launchpad.svg" alt="Launchpad" width="48" height="48" loading="lazy" />
              </span>
              <span class="hero-v2__cluster-tip">Effortlessly run local apps</span>
              <span class="hero-v2__cluster-name">Launchpad</span>
            </ExternalLink>

          </span>
        </p>
        </div>

      </div>

      <!-- Right Column - Profile Image with Rotation Effect -->
      <div class="hero-v2__image-wrapper">
        <div class="hero-v2__image-container" id="profile-container" tabindex="0" aria-label="Profile image carousel. Hover or focus to pause.">
          <Image src={profilePhoto1} alt="Prince Jain" class="hero-v2__image hero-v2__image--active" data-index="0" width={640} height={640} fetchpriority="high" loading="eager" decoding="sync" />
          <Image src={profilePhoto2} alt="Prince Jain" class="hero-v2__image" data-index="1" width={640} height={640} loading="lazy" />
          <Image src={profilePhoto3} alt="Prince Jain" class="hero-v2__image" data-index="2" width={640} height={640} loading="lazy" />
          <Image src={profilePhoto4} alt="Prince Jain" class="hero-v2__image" data-index="3" width={640} height={640} loading="lazy" />

        </div>
        <div class="hero-v2__glow hero-v2__glow--1"></div>
        <div class="hero-v2__glow hero-v2__glow--2"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Profile image rotation effect with hover/focus pause + reduced motion support
  const images = document.querySelectorAll('.hero-v2__image');
  const container = document.getElementById('profile-container');
  const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  let currentIndex = 0;
  let intervalId: number | undefined;
  let isPaused = false;

  function rotateImages() {
    if (isPaused || reduceMotionQuery.matches || images.length === 0) return;

    images.forEach((img, i) => {
      img.classList.toggle('hero-v2__image--active', i === currentIndex);
    });

    currentIndex = (currentIndex + 1) % images.length;
  }

  function startRotation() {
    if (reduceMotionQuery.matches || intervalId) return;
    intervalId = window.setInterval(rotateImages, 1500);
  }

  function stopRotation() {
    if (!intervalId) return;
    window.clearInterval(intervalId);
    intervalId = undefined;
  }

  if (container) {
    container.addEventListener('mouseenter', () => {
      isPaused = true;
    });
    container.addEventListener('mouseleave', () => {
      isPaused = false;
    });
    container.addEventListener('focusin', () => {
      isPaused = true;
    });
    container.addEventListener('focusout', () => {
      isPaused = false;
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopRotation();
    else onMotionPreferenceChange();
  });

  const onMotionPreferenceChange = () => {
    if (reduceMotionQuery.matches) {
      stopRotation();
      return;
    }
    startRotation();
  };

  if (typeof reduceMotionQuery.addEventListener === 'function') {
    reduceMotionQuery.addEventListener('change', onMotionPreferenceChange);
  } else if (typeof reduceMotionQuery.addListener === 'function') {
    reduceMotionQuery.addListener(onMotionPreferenceChange);
  }

  onMotionPreferenceChange();
</script>

<style>
  .hero-v2 {
    padding: var(--space-24) 0 var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-v2__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-v2__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
    }
  }

  .hero-v2__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-v2__headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--gray-900);
  }

  .text-accent-primary {
    color: var(--color-accent);
  }

  .text-accent-secondary {
    color: var(--color-accent-secondary);
  }

  .hero-v2__intro {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--gray-600);
    max-width: 520px;
  }

  .hero-v2__intro strong {
    color: var(--gray-900);
    font-weight: 600;
  }

  /* CTA Buttons */
  .hero-v2__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* Image Column */
  .hero-v2__image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-v2__image-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    border-radius: 2.5rem;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    transform: rotate(2deg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--gray-100);
  }

  .hero-v2__image-container:hover {
    transform: rotate(0deg);
  }

  .hero-v2__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-v2__image--active {
    opacity: 1;
    z-index: 10;
  }

  /* Glow Effects */
  .hero-v2__glow {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    filter: blur(100px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-v2__glow--1 {
    top: -3rem;
    right: -3rem;
    background: hsla(28, 100%, 50%, 0.08);
  }

  .hero-v2__glow--2 {
    bottom: -3rem;
    left: -3rem;
    background: hsla(340, 80%, 55%, 0.08);
  }

  /* Inline rows — text + icons on one line */
  .hero-v2__inline-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--gray-400);
    margin: 0;
    line-height: 1.6;
  }

  /* Company logo cards — larger icons like side projects */
  .hero-v2__icon-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: white;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    vertical-align: middle;
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .hero-v2__icon-card:hover {
    box-shadow: var(--shadow-md);
    transform: scale(1.05);
  }

  .hero-v2__icon-card-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  /* Proof block (companies + side projects). Transparent on desktop — children
     flow as siblings in hero-v2__content; on mobile becomes a bounding card. */
  .hero-v2__proof {
    display: contents;
  }

  /* Companies row groups — desktop flattens them into one inline sentence,
     mobile uses them as the two stacked label-rows ("Now" / "Previously"). */
  .hero-v2__co-row {
    display: contents;
  }

  .hero-v2__co-label {
    display: none;
  }

  .hero-v2__icon-card-logo--mobile {
    display: none;
  }

  /* Icon cluster — overlapping group that spreads */
  .hero-v2__cluster {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-left: var(--space-1);
  }

  .hero-v2__cluster-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-md);
  }

  .hero-v2__cluster-item--z0 { z-index: 0; }
  .hero-v2__cluster-item--z1 { z-index: 1; }
  .hero-v2__cluster-item--z2 { z-index: 2; }
  .hero-v2__cluster-item--z3 { z-index: 3; }

  .hero-v2__cluster-item:hover {
    z-index: 20;
    transform: scale(1.1);
    box-shadow: var(--shadow-lg);
  }

  /* Stacked items overlap on desktop, spread on hover */
  .hero-v2__cluster-item--stacked {
    margin-left: var(--space-1);
  }

  @media (min-width: 768px) {
    .hero-v2__cluster-item--stacked {
      margin-left: -12px;
    }

    .hero-v2__cluster:hover .hero-v2__cluster-item--stacked {
      margin-left: var(--space-1);
    }
  }

  .hero-v2__cluster-card {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    background: white;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-v2__cluster-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Tooltip — slides up with playful tilt */
  .hero-v2__cluster-tip {
    position: absolute;
    top: -48px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    padding: var(--space-1) var(--space-2);
    background: white;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.025em;
    color: var(--gray-900);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    z-index: 50;
  }

  .hero-v2__cluster-item:hover .hero-v2__cluster-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(2deg);
  }

  /* Short product-name caption — desktop uses the hover tooltip instead */
  .hero-v2__cluster-name {
    display: none;
  }

  @media (max-width: 767px) {
    .hero-v2 {
      padding: var(--space-12) 0 var(--space-8);
    }

    /* Promote content children into the grid so the photo can sit between
       the headline and intro (interleaving across the two columns). */
    .hero-v2__grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0;
    }

    .hero-v2__content {
      display: contents;
    }

    /* Tier order: Headline → Photo → Intro → CTAs → Companies → Projects */
    .hero-v2__headline { order: 1; }
    .hero-v2__image-wrapper { order: 2; }
    .hero-v2__intro { order: 3; }
    .hero-v2__cta { order: 4; }
    .hero-v2__inline-row--companies { order: 5; }
    .hero-v2__inline-row--projects { order: 6; }

    .hero-v2__headline {
      font-size: 2.5rem;
    }

    /* Identity tier — photo + intro read as one unit under the headline */
    .hero-v2__image-wrapper {
      width: 100%;
      margin-top: var(--space-6);
    }

    .hero-v2__image-container {
      max-width: 220px;
      transform: rotate(0deg);
    }

    .hero-v2__intro {
      margin-top: var(--space-5);
      text-align: center;
      font-size: var(--text-base);
    }

    /* Action tier — generous break so the CTAs stand alone */
    .hero-v2__cta {
      margin-top: var(--space-8);
      justify-content: center;
    }

    /* Proof / explore tier — detached by a divider and visually de-emphasized */
    .hero-v2__inline-row {
      justify-content: center;
      font-size: var(--text-xs);
      gap: var(--space-1);
    }

    /* Bounding card groups the social-proof + projects as one block */
    .hero-v2__proof {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      order: 5;
      width: 100%;
      margin-top: var(--space-16);
      padding: var(--space-6) var(--space-5);
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }

    /* Companies — break inline sentence into two labeled rows.
       Now [Flipkart]
       Previously [Paytm] [Oracle] */
    .hero-v2__inline-row--companies {
      width: 100%;
      margin-top: 0;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
    }

    .hero-v2__co-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      width: max-content;
      max-width: 100%;
    }

    .hero-v2__co-text {
      display: none;
    }

    .hero-v2__co-label {
      display: inline-block;
      min-width: 96px;
      font-size: var(--text-xs);
      color: var(--gray-500);
      font-weight: 400;
      text-align: left;
    }

    .hero-v2__icon-card {
      width: 42px;
      height: 42px;
      border-radius: 10px;
    }

    .hero-v2__icon-card-logo {
      width: 28px;
      height: 28px;
    }

    .hero-v2__icon-card-logo--desktop {
      display: none;
    }

    .hero-v2__icon-card-logo--mobile {
      display: block;
    }

    /* Side projects → secondary tier; smaller cards + dimmer labels so the
       companies strip above remains the dominant trust signal. */
    .hero-v2__inline-row--projects {
      width: 100%;
      margin-top: 0;
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-subtle);
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
    }

    .hero-v2__inline-row--projects > span:first-child {
      text-align: center;
      font-size: var(--text-2xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gray-500);
      font-weight: 500;
    }

    .hero-v2__inline-row--projects .hero-v2__cluster {
      flex-direction: row;
      justify-content: center;
      width: 100%;
      margin: 0;
      gap: var(--space-4);
    }

    .hero-v2__cluster-item,
    .hero-v2__cluster-item--stacked {
      flex-direction: column;
      align-items: center;
      width: auto;
      height: auto;
      gap: var(--space-2);
      margin-left: 0;
      box-shadow: none;
    }

    .hero-v2__cluster-item:hover {
      transform: none;
      box-shadow: none;
    }

    .hero-v2__cluster-card {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      border-radius: 9px;
    }

    /* Hide the hover tooltip; show the persistent product-name caption */
    .hero-v2__cluster-tip {
      display: none;
    }

    .hero-v2__cluster-name {
      display: block;
      font-size: var(--text-2xs);
      font-weight: 500;
      color: var(--gray-500);
      text-align: center;
      line-height: 1.2;
    }

  }
</style>
